* {
    bg:          #090d10EB;
    bg-alt:      #131c22CC;
    fg:          #f8fafc;
    fg-dim:      #6ee7b7;
    accent:      #10b981;
    accent-alt:  #f97316;
    background-color: transparent;
    text-color:       @fg;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    10px;
    padding:          16px;
    width:            52%;
}

mainbox { children: [ inputbar, listview ]; spacing: 12px; }

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @accent-alt;
    border-radius:    8px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          10px;
}

prompt { text-color: @accent; font: "JetBrainsMono Nerd Font Bold 11"; }
entry  { placeholder: "Buscar..."; placeholder-color: @fg-dim; text-color: @fg; }

listview { lines: 8; columns: 1; spacing: 6px; fixed-height: false; }
element { padding: 9px 12px; border-radius: 6px; }
element selected { background-color: @accent; text-color: #090d10; }
element-text { text-color: inherit; }
