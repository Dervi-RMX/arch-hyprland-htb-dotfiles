* {
    bg:          #09090bEB;
    bg-alt:      #18181bCC;
    fg:          #fafafa;
    fg-dim:      #a1a1aa;
    accent:      #ffffff;
    accent-alt:  #71717a;
    background-color: transparent;
    text-color:       @fg;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    4px 20px 4px 20px;
    padding:          16px;
    width:            52%;
}

mainbox { children: [ inputbar, listview ]; spacing: 12px; }

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @accent-alt;
    border-radius:    2px 12px 2px 12px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          10px;
}

prompt { text-color: @accent; font: "JetBrainsMono Nerd Font Bold 11"; }
entry  { placeholder: "Buscar..."; placeholder-color: @fg-dim; text-color: @fg; }

listview { lines: 8; columns: 1; spacing: 6px; fixed-height: false; }

element {
    padding:       9px 12px;
    border-radius: 2px 10px 2px 10px;
}

element selected {
    background-color: @accent;
    text-color:       #09090b;
}

element-text { text-color: inherit; }
