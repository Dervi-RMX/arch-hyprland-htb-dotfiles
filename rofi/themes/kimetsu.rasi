* {
    bg:          #07111aEB;
    bg-alt:      #0c1d2cCC;
    fg:          #f0f9ff;
    fg-dim:      #7dd3fc;
    accent:      #38bdf8;
    accent-alt:  #10b981;
    background-color: transparent;
    text-color:       @fg;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    20px 4px 20px 4px;
    padding:          16px;
    width:            52%;
}

mainbox { children: [ inputbar, listview ]; spacing: 12px; }

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @accent-alt;
    border-radius:    12px 3px 12px 3px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          10px;
}

prompt { text-color: @accent-alt; font: "JetBrainsMono Nerd Font Bold 11"; }
entry  { placeholder: "Buscar..."; placeholder-color: @fg-dim; text-color: @fg; }

listview { lines: 8; columns: 1; spacing: 6px; fixed-height: false; }

element {
    padding:       9px 12px;
    border-radius: 10px 3px 10px 3px;
}

element selected {
    background-color: @accent;
    text-color:       #07111a;
}

element-text { text-color: inherit; }
