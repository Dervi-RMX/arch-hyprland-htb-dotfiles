* {
    bg:          #110a1fE6;
    bg-alt:      #1e1238CC;
    fg:          #fef9c3;
    fg-dim:      #c4b5fd;
    accent:      #fbbf24;
    accent-alt:  #a855f7;
    background-color: transparent;
    text-color:       @fg;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    4px;
    padding:          16px;
    width:            52%;
}

mainbox { children: [ inputbar, listview ]; spacing: 12px; }

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @accent-alt;
    border-radius:    3px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          10px;
}

prompt { text-color: @accent; font: "JetBrainsMono Nerd Font Bold 11"; }
entry  { placeholder: "Buscar..."; placeholder-color: @fg-dim; text-color: @fg; }

listview { lines: 8; columns: 1; spacing: 6px; fixed-height: false; }

element {
    padding:       9px 12px;
    border-radius: 3px;
}

element selected {
    background-color: @accent;
    text-color:       #110a1f;
}

element-text { text-color: inherit; }
