{
    "layer": "top",
    "position": "left",
    "width": 46,
    "margin-top": 10,
    "margin-bottom": 10,
    "margin-left": 8,
    "margin-right": 0,
    "spacing": 0,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "wlr/taskbar"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "custom/vpn-icon",
        "pulseaudio",
        "cpu",
        "memory",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "󰣇",
        "on-click": "~/.local/bin/shinobi-dashboard-toggle",
        "tooltip": true,
        "tooltip-format": "Aplicaciones (Rofi)",
        "on-click-right": "rofi -show drun"
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4,
                5
            ]
        }
    },
    "clock": {
        "format": "{:%H\n%M}",
        "tooltip-format": "{:%Y-%m-%d | %I:%M %p}"
    },
    "custom/vpn-icon": {
        "format": "󰖂",
        "exec": "ip -4 addr show tun0 2>/dev/null | grep -oP '(?<=inet\\s)\\d+(\\.\\d+){3}' || echo 'Sin VPN'",
        "interval": 5,
        "tooltip": true
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol",
        "tooltip-format": "Volumen: {volume}%"
    },
    "cpu": {
        "format": "",
        "interval": 2,
        "tooltip-format": "CPU: {usage}%"
    },
    "memory": {
        "format": "",
        "interval": 3,
        "tooltip-format": "RAM: {percentage}%"
    },
    "custom/power": {
        "format": "",
        "on-click": "pkill -x wlogout || wlogout -b 6",
        "tooltip": false
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 20,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "Rofi",
            "wlogout"
        ]
    },
    "tray": {
        "icon-size": 16,
        "spacing": 6
    }
}
