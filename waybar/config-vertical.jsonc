{
    "layer": "top",
    "position": "left",
    "width": 46,
    "margin-top": 10,
    "margin-bottom": 10,
    "margin-left": 8,
    "margin-right": 0,
    "spacing": 0,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/spotify-icon",
        "custom/vpn-icon",
        "pulseaudio",
        "cpu",
        "memory",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "󰣇",
        "on-click": "bash -c 'env WAYLAND_DISPLAY=$(ls /run/user/$(id -u)/wayland-* 2>/dev/null | grep -v \\.lock | head -n 1 | xargs basename) HYPRLAND_INSTANCE_SIGNATURE=$(ls -1 /run/user/$(id -u)/hypr/ 2>/dev/null | head -n 1) pkill -x rofi || env WAYLAND_DISPLAY=$(ls /run/user/$(id -u)/wayland-* 2>/dev/null | grep -v \\.lock | head -n 1 | xargs basename) HYPRLAND_INSTANCE_SIGNATURE=$(ls -1 /run/user/$(id -u)/hypr/ 2>/dev/null | head -n 1) rofi -show drun'",
        "tooltip": true,
        "tooltip-format": "Aplicaciones (Rofi)"
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4,
                5
            ]
        }
    },
    "clock": {
        "format": "{:%H\n%M}",
        "tooltip-format": "{:%Y-%m-%d | %I:%M %p}"
    },
    "custom/spotify-icon": {
        "format": "",
        "exec": "playerctl -p spotify metadata --format '{{artist}} - {{title}}' 2>/dev/null || echo 'Spotify'",
        "interval": 5,
        "on-click": "playerctl -p spotify play-pause",
        "tooltip": true
    },
    "custom/vpn-icon": {
        "format": "󰖂",
        "exec": "ip -4 addr show tun0 2>/dev/null | grep -oP '(?<=inet\\s)\\d+(\\.\\d+){3}' || echo 'Sin VPN'",
        "interval": 5,
        "tooltip": true
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol",
        "tooltip-format": "Volumen: {volume}%"
    },
    "cpu": {
        "format": "",
        "interval": 2,
        "tooltip-format": "CPU: {usage}%"
    },
    "memory": {
        "format": "",
        "interval": 3,
        "tooltip-format": "RAM: {percentage}%"
    },
    "custom/power": {
        "format": "",
        "on-click": "pkill -x wlogout || wlogout -b 6",
        "tooltip": false
    }
}
