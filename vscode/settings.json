        "sideBar.border": "#34d39944",
        "sideBarSectionHeader.background": "#0a0e12",
        "activityBar.background": "#0a0e12",
        "activityBar.foreground": "#10b981",
        "activityBar.inactiveForeground": "#f8fafc66",
        "activityBar.border": "#34d39944",
        "activityBarBadge.background": "#10b981",
        "activityBarBadge.foreground": "#0a0e12",
        "titleBar.activeBackground": "#0a0e12",
        "titleBar.activeForeground": "#10b981",
        "titleBar.inactiveBackground": "#0a0e12",
        "titleBar.border": "#34d39944",
        "statusBar.background": "#121c22",
        "statusBar.foreground": "#10b981",
        "statusBar.border": "#34d39944",
        "statusBar.noFolderBackground": "#121c22",
        "tab.activeBackground": "#0a0e12",
