{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "application",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 14,
  "control-center-margin-left": 0,
  "notification-icon-size": 44,
  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 390,
  "control-center-height": 640,
  "notification-window-width": 370,
  "keyboard-shortcuts": true,
  "transition-time": 250,
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "\u26a1 Centro de Notificaciones",
      "clear-all-button": true,
      "button-text": "Limpiar"
    },
    "dnd": {
      "text": "No Molestar"
    },
    "mpris": {
      "image-size": 56,
      "image-radius": 10
    }
  },
  "scripts": {
    "shinobi-update": {
      "exec": "/home/dervi/.local/bin/run-shinobi-update",
      "summary": "Actualizaci\u00f3n en shinobi-hypr",
      "run-on": "action"
    }
  }
}
