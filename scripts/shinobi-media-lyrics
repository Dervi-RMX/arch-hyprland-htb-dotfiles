#!/usr/bin/env python3
import os
if os.popen("playerctl status 2>/dev/null").read().strip() != "Playing": raise SystemExit(0)
import hashlib, json, pathlib, re, subprocess, urllib.parse, urllib.request

def run(cmd):
    try: return subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=True).strip()
    except Exception: return ""

meta = run(["playerctl", "metadata", "--format", "{{artist}}|||{{title}}"])
if "|||" not in meta: raise SystemExit(0)
artist, title = [x.strip() for x in meta.split("|||", 1)]
if not title: raise SystemExit(0)

main_artist = artist.split(",")[0].strip()
clean_title = re.sub(r"\s*[\(\[].*?[\)\]]", "", title).strip()
pos = float(run(["playerctl", "position"]) or 0.0)
cache = pathlib.Path(f"/tmp/shinobi-lyrics-{hashlib.md5(f'{main_artist}|{clean_title}'.lower().encode()).hexdigest()}.json")

data = json.loads(cache.read_text()) if cache.exists() and cache.stat().st_size > 10 else {}
if not data:
    hdrs = {"User-Agent": "ShinobiHypr/1.0"}
    for url in [
        f"https://lrclib.net/api/get?{urllib.parse.urlencode({'artist_name': main_artist, 'track_name': clean_title})}",
        f"https://lrclib.net/api/search?{urllib.parse.urlencode({'q': f'{main_artist} {clean_title}'})}",
        f"https://lrclib.net/api/search?{urllib.parse.urlencode({'q': clean_title})}",
    ]:
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers=hdrs), timeout=4) as r:
                res = json.loads(r.read().decode())
                if isinstance(res, list) and res:
                    data = next((i for i in res if i.get("syncedLyrics")), res[0])
                elif isinstance(res, dict) and (res.get("syncedLyrics") or res.get("plainLyrics")):
                    data = res
                if data.get("syncedLyrics") or data.get("plainLyrics"):
                    cache.write_text(json.dumps(data))
                    break
        except Exception:
            pass

synced = data.get("syncedLyrics") or ""
if synced:
    cur = ""
    for m in re.finditer(r"\[(\d+):(\d+(?:\.\d+)?)\]\s*(.*)", synced):
        if int(m.group(1)) * 60 + float(m.group(2)) <= pos + 0.5: cur = m.group(3).strip()
        else: break
    if cur: print(f"󰎈  {cur}"); raise SystemExit(0)

plain = [l.strip() for l in (data.get("plainLyrics") or "").splitlines() if l.strip()]
if plain: print(f"󰎈  {plain[0]}")
