#!/usr/bin/env python3
import hashlib, json, pathlib, re, subprocess, urllib.parse, urllib.request

def run(cmd):
    try:
        return subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=True).strip()
    except Exception:
        return ""

meta = run(["playerctl", "metadata", "--format", "{{artist}}|||{{title}}"])
if not meta or "|||" not in meta:
    raise SystemExit(0)
artist, title = [x.strip() for x in meta.split("|||", 1)]
main_artist = artist.split(",")[0].strip()
pos = float(run(["playerctl", "position"]) or 0.0)

key = hashlib.md5(f"{main_artist}|{title}".lower().encode()).hexdigest()
cache = pathlib.Path(f"/tmp/shinobi-lyrics-{key}.json")

if not cache.exists():
    data = {}
    hdrs = {"User-Agent": "ShinobiHypr/1.0"}
    for url in [
        f"https://lrclib.net/api/get?{urllib.parse.urlencode({'artist_name': main_artist, 'track_name': title})}",
        f"https://lrclib.net/api/search?{urllib.parse.urlencode({'q': f'{main_artist} {title}'})}",
    ]:
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers=hdrs), timeout=4) as r:
                res = json.loads(r.read().decode())
                if isinstance(res, list) and res:
                    data = next((i for i in res if i.get("syncedLyrics")), res[0])
                elif isinstance(res, dict) and (res.get("syncedLyrics") or res.get("plainLyrics")):
                    data = res
                if data:
                    break
        except Exception:
            pass
    cache.write_text(json.dumps(data))
else:
    data = json.loads(cache.read_text())

synced = data.get("syncedLyrics") or ""
if synced:
    cur = ""
    for m in re.finditer(r"\[(\d+):(\d+(?:\.\d+)?)\]\s*(.*)", synced):
        if int(m.group(1)) * 60 + float(m.group(2)) <= pos + 0.5:
            cur = m.group(3).strip()
        else:
            break
    if cur:
        print(f"󰎈  {cur}")
        raise SystemExit(0)

plain = (data.get("plainLyrics") or "").strip().splitlines()
if plain:
    print(f"󰎈  {plain[0].strip()}")
