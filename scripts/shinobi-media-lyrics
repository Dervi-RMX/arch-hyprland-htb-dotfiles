#!/usr/bin/env python3
import hashlib, json, pathlib, re, subprocess, urllib.parse, urllib.request

def run(cmd):
    try:
        return subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=True).strip()
    except Exception:
        return ""

meta = run(["playerctl", "metadata", "--format", "{{artist}}|||{{title}}"])
if not meta or "|||" not in meta:
    raise SystemExit(0)
artist, title = [x.strip() for x in meta.split("|||", 1)]
if not title:
    raise SystemExit(0)

pos_str = run(["playerctl", "position"])
pos = float(pos_str) if pos_str else 0.0

key = hashlib.md5(f"{artist}|{title}".lower().encode()).hexdigest()
cache = pathlib.Path(f"/tmp/shinobi-lyrics-{key}.json")

if not cache.exists():
    data = {}
    hdrs = {"User-Agent": "ShinobiHypr/1.0"}
    q = urllib.parse.urlencode({"artist_name": artist, "track_name": title})
    try:
        req = urllib.request.Request(f"https://lrclib.net/api/get?{q}", headers=hdrs)
        with urllib.request.urlopen(req, timeout=3) as r:
            data = json.loads(r.read().decode())
    except Exception:
        try:
            sq = urllib.parse.urlencode({"q": f"{artist} {title}"})
            req = urllib.request.Request(f"https://lrclib.net/api/search?{sq}", headers=hdrs)
            with urllib.request.urlopen(req, timeout=3) as r:
                items = json.loads(r.read().decode())
                if items:
                    data = next((i for i in items if i.get("syncedLyrics")), items[0])
        except Exception:
            data = {}
    cache.write_text(json.dumps(data))
else:
    data = json.loads(cache.read_text())

synced = data.get("syncedLyrics") or ""
if not synced:
    raise SystemExit(0)

current = ""
for m in re.finditer(r"\[(\d+):(\d+(?:\.\d+)?)\]\s*(.*)", synced):
    ts = int(m.group(1)) * 60 + float(m.group(2))
    if ts <= pos + 0.4:
        current = m.group(3).strip()
    else:
        break

if current:
    print(f"󰎈  {current}")
