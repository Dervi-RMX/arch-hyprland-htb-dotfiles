#!/usr/bin/env bash
WALL_CSS="$HOME/.config/waybar/colors-wallust.css"
VSC_DIR="$HOME/.config/Code/User"
mkdir -p "$VSC_DIR"

# Extraer colores activos de wallust o usar paleta Shinobi por defecto
BG=$(grep -Po '@define-color\s+bg\s+\K[^;]+' "$WALL_CSS" 2>/dev/null | head -n1)
BG_ALT=$(grep -Po '@define-color\s+bg-alt\s+\K[^;]+' "$WALL_CSS" 2>/dev/null | head -n1)
FG=$(grep -Po '@define-color\s+fg\s+\K[^;]+' "$WALL_CSS" 2>/dev/null | head -n1)
ACCENT=$(grep -Po '@define-color\s+accent\s+\K[^;]+' "$WALL_CSS" 2>/dev/null | head -n1)
ACCENT2=$(grep -Po '@define-color\s+accent2\s+\K[^;]+' "$WALL_CSS" 2>/dev/null | head -n1)
BORDER=$(grep -Po '@define-color\s+border\s+\K[^;]+' "$WALL_CSS" 2>/dev/null | head -n1)

python3 - << PY
import json, pathlib, re

def to_hex(val, fallback):
    if not val:
        return fallback
    val = val.strip()
    if val.startswith("#") and len(val) in (7, 9):
        return val[:7]
    m = re.match(r'rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)', val)
    if m:
        r, g, b = map(int, m.groups())
        return f"#{r:02x}{g:02x}{b:02x}"
    return fallback

bg = to_hex("""$BG""", "#0d1017")
bg_alt = to_hex("""$BG_ALT""", "#141923")
fg = to_hex("""$FG""", "#f8fafc")
accent = to_hex("""$ACCENT""", "#10b981")
accent2 = to_hex("""$ACCENT2""", "#f97316")
border = to_hex("""$BORDER""", accent)

settings_path = pathlib.Path.home() / ".config/Code/User/settings.json"
try:
    data = json.loads(settings_path.read_text()) if settings_path.exists() else {}
except Exception:
    data = {}

data.update({
    "workbench.colorTheme": "Default Dark Modern",
    "workbench.iconTheme": "material-icon-theme",
    "window.titleBarStyle": "custom",
    "window.menuBarVisibility": "toggle",
    "workbench.activityBar.location": "bottom",
    "workbench.statusBar.visible": True,
    "workbench.startupEditor": "none",
    "workbench.layoutControl.enabled": False,
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'FiraCode Nerd Font', monospace",
    "editor.fontSize": 14,
    "editor.lineHeight": 1.6,
    "editor.fontLigatures": True,
    "editor.cursorBlinking": "phase",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": True,
    "editor.minimap.enabled": False,
    "editor.renderLineHighlight": "all",
    "editor.bracketPairColorization.enabled": True,
    "editor.guides.bracketPairs": "active",
    "editor.padding.top": 14,
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": True,
    "workbench.colorCustomizations": {
        "editor.background": bg,
        "editor.foreground": fg,
        "editorGutter.background": bg,
        "sideBar.background": bg_alt,
        "sideBar.foreground": fg,
        "sideBar.border": border + "44",
        "sideBarSectionHeader.background": bg,
        "activityBar.background": bg,
        "activityBar.foreground": accent,
        "activityBar.inactiveForeground": fg + "66",
        "activityBar.border": border + "44",
        "activityBarBadge.background": accent,
        "activityBarBadge.foreground": bg,
        "titleBar.activeBackground": bg,
        "titleBar.activeForeground": accent,
        "titleBar.inactiveBackground": bg,
        "titleBar.border": border + "44",
        "statusBar.background": bg_alt,
        "statusBar.foreground": accent,
        "statusBar.border": border + "44",
        "statusBar.noFolderBackground": bg_alt,
        "tab.activeBackground": bg,
        "tab.activeForeground": accent,
        "tab.activeBorderTop": accent,
        "tab.inactiveBackground": bg_alt,
        "tab.inactiveForeground": fg + "77",
        "tab.border": bg,
        "editorGroupHeader.tabsBackground": bg_alt,
        "editorCursor.foreground": accent2,
        "editor.lineHighlightBackground": accent + "18",
        "editor.selectionBackground": accent + "38",
        "editorBracketMatch.border": accent2,
        "list.activeSelectionBackground": accent + "33",
        "list.activeSelectionForeground": accent,
        "list.hoverBackground": accent + "1a",
        "input.background": bg,
        "input.border": border + "66",
        "focusBorder": accent,
        "terminal.background": bg,
        "terminal.foreground": fg,
        "terminalCursor.foreground": accent2,
        "panel.background": bg,
        "panel.border": border + "44",
        "panelTitle.activeBorder": accent,
        "panelTitle.activeForeground": accent
    }
})

settings_path.write_text(json.dumps(data, indent=4, ensure_ascii=False) + "\n")
PY
