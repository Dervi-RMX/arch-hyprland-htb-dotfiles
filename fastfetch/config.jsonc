{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "arch",
        "color": {
            "1": "white"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },

    "display": {
        "separator": " 󰁔 ",
        "brightColor": true,
        "color": {
            "keys": "magenta",
            "title": "cyan",
            "output": "white",
            "separator": "magenta"
        },
        "key": {
            "width": 12,
            "type": "string"
        }
    },

    "modules": [
        "break",
        "title",
        "separator",

        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "host",
            "key": "HOST"
        },
        {
            "type": "kernel",
            "key": "KERNEL"
        },
        {
            "type": "uptime",
            "key": "UPTIME"
        },
        {
            "type": "packages",
            "key": "PACKAGES"
        },
        {
            "type": "shell",
            "key": "SHELL"
        },

        "break",

        {
            "type": "de",
            "key": "DESKTOP"
        },
        {
            "type": "wm",
            "key": "WINDOW"
        },
        {
            "type": "theme",
            "key": "THEME"
        },
        {
            "type": "icons",
            "key": "ICONS"
        },
        {
            "type": "terminal",
            "key": "TERMINAL"
        },
        {
            "type": "terminalfont",
            "key": "FONT"
        },

        "break",

        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "RAM"
        },
        {
            "type": "swap",
            "key": "SWAP"
        },
        {
            "type": "disk",
            "key": "DISK"
        },
        {
            "type": "display",
            "key": "DISPLAY"
        },

        "break",
        "colors"
    ]
}
